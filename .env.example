# Copy this file to `.env` and fill in your key.
# The user creates the real `.env` locally (never commit it).
# Get a free key: https://pixabay.com/api/docs/ (Basic plan is enough).

# Required — Pixabay API key
PIXABAY_API_KEY=PASTE_YOUR_PIXABAY_KEY_HERE

# Optional — override defaults without touching code
PIXABAY_BASE_URL=https://pixabay.com/api/
PIXABAY_DEFAULT_PER_PAGE=20
PIXABAY_DEFAULT_IMAGE_TYPE=photo
PIXABAY_DEFAULT_SAFESEARCH=true
